---
// /weather/ 的 id 版。版面與文案共用 WeatherPageBody + weatherPageCopy，
// 這裡只負責 head（title / description / hreflang / JSON-LD）與外框。
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import TopStrip from '../../components/TopStrip.astro';
import Footer from '../../components/Footer.astro';
import WeatherPageBody from '../../components/WeatherPageBody.astro';
import { getWeatherCopy, WEATHER_HREFLANGS } from '../../data/weatherPageCopy';

const SITE_URL = 'https://gobaligo.id';
const lang = 'id' as const;
const c = getWeatherCopy(lang);

const title = c.title(new Date().getFullYear());
const description = c.description;
const pageUrl = `${SITE_URL}${c.path}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': c.breadcrumbHome, 'item': `${SITE_URL}${c.homePath}` },
        { '@type': 'ListItem', 'position': 2, 'name': c.breadcrumbSelf, 'item': pageUrl },
      ],
    },
    {
      '@type': 'WebPage',
      '@id': pageUrl,
      'name': title,
      'description': description,
      'url': pageUrl,
      'inLanguage': c.inLanguage,
      'about': {
        '@type': 'Place',
        'name': c.placeName,
        'address': { '@type': 'PostalAddress', 'addressRegion': 'Bali', 'addressCountry': 'ID' },
      },
    },
    {
      '@type': 'FAQPage',
      'mainEntity': c.faqs.map((f) => ({
        '@type': 'Question',
        'name': f.q,
        'acceptedAnswer': { '@type': 'Answer', 'text': f.a },
      })),
    },
  ],
};
---

<html lang={c.htmlLang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      noSuffix={true}
      hreflangs={WEATHER_HREFLANGS}
    />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <Header lang="id" basePath="weather" />
    <TopStrip lang={lang} />
    <WeatherPageBody lang={lang} />
    <Footer lang={lang} />
  </body>
</html>
