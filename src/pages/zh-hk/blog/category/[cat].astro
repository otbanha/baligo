---
export const prerender = true;
import BlogCategoryPage from '../../../../components/BlogCategoryPage.astro';

export function getStaticPaths() {
  return [
    '新手指南', '住宿推薦', '峇里島分區攻略', '簽證通關',
    '叫車包車', '家庭親子', '遊記分享', '美食景點活動', '套裝行程',
    // 旅遊專題（236 篇，全站最大的分類）與購物指南（27 篇）原本沒有靜態分類頁，
    // 只能靠 /blog/?cat= 的前端篩選，爬蟲看不到內容也無法累積排名（2026-11 稽核）。
    '旅遊專題', '購物指南',
  ].map(cat => ({ params: { cat } }));
}

const { cat } = Astro.params;
---
<BlogCategoryPage lang="zh-hk" cat={cat!} />
