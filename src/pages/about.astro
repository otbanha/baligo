---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import TopStrip from '../components/TopStrip.astro';
import Footer from '../components/Footer.astro';
import { AUTHOR, getAuthorPerson } from '../data/author';

const lang = 'zh-tw';
const basePath = 'about';

const title = '關於小傑爸｜Go Bali Go 峇里島旅遊攻略站長';
const description = '認識 Go Bali Go 站長小傑爸：台灣人，長住印尼，長期分享峇里島簽證、換錢、交通與住宿的第一手實查資訊，幫你訂房不踩雷、自由行不走冤枉路。';

const person = getAuthorPerson(lang);

// ProfilePage + Person（@id 與文章 author 一致，做跨頁實體整合，補強 E-E-A-T）
const profileSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    '@id': person['@id'],
    name: person.name,
    url: person.url,
    image: person.image,
    description: person.description,
    sameAs: person.sameAs,
    jobTitle: 'Go Bali Go 站長',
    nationality: 'Taiwan',
    knowsAbout: [
      '峇里島簽證', '峇里島觀光稅', '峇里島換錢', '峇里島叫車',
      '峇里島住宿推薦', '峇里島自由行', '峇里島看醫生',
    ],
    worksFor: {
      '@type': 'Organization',
      name: 'Go Bali Go',
      url: 'https://gobaligo.id',
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Go Bali Go', item: 'https://gobaligo.id' },
    { '@type': 'ListItem', position: 2, name: '關於小傑爸', item: AUTHOR.url },
  ],
};
---

<html lang="zh-TW">
<head>
  <BaseHead title={title} description={description} type="website" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(profileSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
</head>

<body>
  <Header lang={lang} basePath={basePath} />
  <TopStrip lang={lang} />

  <main class="about-wrap">
    <article class="about-card">
      <header class="about-hero">
        <img class="about-avatar" src={AUTHOR.avatar} alt="小傑爸" width="68" height="68" loading="eager" />
        <div>
          <h1>關於小傑爸</h1>
          <p class="about-role">Go Bali Go 站長</p>
        </div>
      </header>

      <p>
        我是<strong>小傑爸</strong>，台灣人，目前長住印尼，已經住了 13 年，是 <strong>Go Bali Go</strong> 的站長。
      </p>

      <p>
        網站和頻道名稱裡的「小傑」是我兒子。這個品牌從他開始，現在他回台灣念大學，網站由我負責經營。
      </p>

      <p>
        住在峇里島，朋友最常問的就是：簽證怎麼辦、換錢會不會被騙、要住哪一區。這些答案隔一陣子就會變，
        所以我把在地生活中實際碰到、確認過的資訊寫下來：
      </p>

      <ul class="about-points">
        <li>📍 <strong>入境規定、觀光稅、收費調整</strong>：人在當地，能第一時間確認</li>
        <li>💱 <strong>換錢、叫車、看醫生</strong>：自己遇過的狀況，整理成避雷指南</li>
        <li>🏨 <strong>住宿</strong>：帶家人實際住過的，寫真實入住體驗</li>
      </ul>

      <p>
        除了網站，我也經營峇里島 FB 社團、YouTube 頻道與峇里島討論區，並和旅行社合作規劃峇里島、科莫多、爪哇行程。
      </p>

      <p>
        有任何峇里島問題，歡迎到<a href="https://community.gobaligo.id/" target="_blank" rel="noopener">討論區</a>發問。
      </p>

      <h2>找我 / 追蹤</h2>
      <div class="about-social">
        <a href="https://www.youtube.com/@j_indonesia" target="_blank" rel="noopener" class="about-social-btn yt">▶ YouTube「小傑印尼」</a>
        <a href="https://www.facebook.com/bali.guide.blog" target="_blank" rel="noopener" class="about-social-btn fb">f Facebook 峇里島旅遊攻略</a>
        <a href="https://www.facebook.com/groups/indonesia.travelguide" target="_blank" rel="noopener" class="about-social-btn fb">f Facebook 社團</a>
        <a href="https://www.instagram.com/go.bali.go/" target="_blank" rel="noopener" class="about-social-btn ig">📷 Instagram</a>
        <a href="https://www.threads.com/@go.bali.go" target="_blank" rel="noopener" class="about-social-btn threads">@ Threads</a>
        <a href="https://community.gobaligo.id/" target="_blank" rel="noopener" class="about-social-btn forum">💬 討論區</a>
      </div>
    </article>
  </main>

  <Footer />

  <style>
    .about-wrap { max-width: 760px; margin: 0 auto; padding: 32px 16px 80px; box-sizing: border-box; }
    .about-card { background: var(--surface, #fff); border-radius: 16px; padding: clamp(20px, 4vw, 40px); box-shadow: var(--box-shadow, 0 4px 20px rgba(0,0,0,0.06)); }
    .about-hero { display: flex; align-items: center; gap: 18px; margin-bottom: 1.2em; }
    .about-avatar { flex: none; width: 68px; height: 68px; border-radius: 50%; object-fit: cover; background: linear-gradient(135deg, var(--ocean, #0f3860), #2a7bb8); }
    .about-hero h1 { margin: 0; font-size: clamp(1.5em, 4vw, 2em); color: var(--ocean, #0f3860); line-height: 1.2; }
    .about-role { margin: 0.3em 0 0; font-size: 0.9em; color: var(--text-light, #64748b); }
    .about-card h2 { font-size: 1.15em; color: var(--ocean, #0f3860); margin: 1.6em 0 0.5em; }
    .about-card p { line-height: 1.85; color: var(--text, #1f2937); }
    .about-points { list-style: none; padding: 0; margin: 0.4em 0; }
    .about-points li { line-height: 1.8; margin-bottom: 0.7em; }
    .about-social { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 0.6em; }
    .about-social-btn { display: inline-flex; align-items: center; gap: 8px; padding: 0.55em 1em; border-radius: 999px; font-weight: 600; font-size: 0.9em; text-decoration: none; color: #fff; }
    .about-social-btn.yt { background: #ff0000; }
    .about-social-btn.fb { background: #1877f2; }
    .about-social-btn.ig { background: #c13584; }
    .about-social-btn.threads { background: #000; }
    .about-social-btn.forum { background: var(--ocean, #0f3860); }
    .about-social-btn:hover { opacity: 0.9; }
  </style>
</body>
</html>
