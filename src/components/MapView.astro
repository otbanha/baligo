---
import type { MapArea } from '../data/maps';
interface Props { area: MapArea; }
const { area } = Astro.props;
---

<div id="map-container">
  <div id="map"></div>
  <div id="map-loading">
    <div class="spinner"></div>
    <p>載入地圖中…</p>
  </div>
  <div id="nearby-bar" class="hidden">
    <span id="nearby-label">附近景點</span>
    <div id="radius-pills">
      <button class="radius-pill active" data-km="1">1km</button>
      <button class="radius-pill" data-km="2">2km</button>
      <button class="radius-pill" data-km="3">3km</button>
    </div>
    <button id="nearby-close">✕</button>
  </div>
  <div id="cat-bar" class="hidden">
    <div id="cat-pills"></div>
  </div>
  <button id="layers-btn" class="hidden" aria-label="地圖圖層" aria-expanded="false" aria-controls="layers-panel">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polygon points="12 2 2 7 12 12 22 7 12 2"/>
      <polyline points="2 17 12 22 22 17"/>
      <polyline points="2 12 12 17 22 12"/>
    </svg>
    <span class="layers-label">圖層</span>
  </button>
  <aside id="layers-panel" class="hidden" aria-label="地圖圖層">
    <div class="lp-head">
      <span class="lp-title">地圖圖層</span>
      <button id="lp-close" aria-label="關閉圖層面板">✕</button>
    </div>
    <div class="lp-actions">
      <button class="lp-act" data-all="show">全部顯示</button>
      <button class="lp-act" data-all="hide">全部隱藏</button>
    </div>
    <div id="lp-list"></div>
  </aside>
  <div id="search-bar">
    <span id="search-icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
    </span>
    <input id="search-input" type="search" placeholder="搜尋景點名稱…" autocomplete="off" aria-label="搜尋景點" />
    <button id="search-clear" class="hidden" aria-label="清除搜尋">✕</button>
  </div>
</div>



<link rel="stylesheet" href="/vendor/maplibre/maplibre-gl.css" />

<style>
  #map-container {
    position: relative;
    width: 100%;
    height: calc(100dvh - 64px - 123px - 52px);
  }

  #map { width: 100%; height: 100%; }

  #map-loading {
    position: absolute;
    inset: 0;
    background: #f0ede8;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    z-index: 2;
    transition: opacity 0.3s;
  }
  :global([data-dark]) #map-loading { background: #1a1f1a; }
  #map-loading.hidden { opacity: 0; pointer-events: none; }

  .spinner {
    width: 36px; height: 36px;
    border: 3px solid #ddd;
    border-top-color: #2d8653;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  #map-loading p { font-size: 14px; color: #888; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* MapLibre popup overrides */
  :global(.maplibregl-popup-content) {
    padding: 0 !important;
    border-radius: 14px !important;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.18) !important;
    min-width: 260px;
  }
  :global([data-dark]) :global(.maplibregl-popup-content) {
    background: #242424 !important;
  }
  :global([data-dark]) :global(.maplibregl-popup-tip) {
    border-top-color: #242424 !important;
  }
  :global(.maplibregl-popup-close-button) {
    font-size: 18px !important;
    color: #aaa !important;
    top: 6px !important;
    right: 8px !important;
    line-height: 1 !important;
    background: transparent !important;
    z-index: 10;
  }

  /* Popup content */
  :global(.popup-thumb) {
    width: 100%; height: 140px;
    background-color: #ddd;
    background-size: 256px 256px;
    background-repeat: no-repeat;
    position: relative;
    overflow: hidden;
  }
  :global(.popup-thumb img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  :global(.popup-thumb-dot) {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 12px; height: 12px;
    background: #e33;
    border: 2.5px solid #fff;
    border-radius: 50%;
    box-shadow: 0 1px 5px rgba(0,0,0,0.4);
  }

  :global(.map-popup) { padding: 12px 14px 14px; }

  :global(.cat-badge) {
    display: inline-block;
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    border-radius: 8px;
    padding: 2px 7px;
    margin-bottom: 6px;
  }

  :global(.map-popup h3) {
    font-size: 15px; font-weight: 700;
    color: #1a1a1a; margin-bottom: 4px; line-height: 1.3;
  }
  :global([data-dark]) :global(.map-popup h3) { color: #f0f0f0; }

  :global(.map-popup p) {
    font-size: 12px; color: #666; line-height: 1.5; margin-bottom: 10px;
  }
  :global([data-dark]) :global(.map-popup p) { color: #aaa; }

  :global(.nav-btn) {
    display: block; background: #1a73e8; color: #fff !important;
    text-align: center; border-radius: 10px; padding: 9px 14px;
    font-size: 13px; font-weight: 700; text-decoration: none; margin-bottom: 8px;
  }

  :global(.share-row) { display: flex; gap: 6px; margin-bottom: 10px; }
  :global(.share-btn) {
    flex: 1; display: block; text-align: center;
    border-radius: 10px; padding: 7px 8px;
    font-size: 11px; font-weight: 700; text-decoration: none;
  }
  :global(.share-wa) { background: #25d366; color: #fff !important; }
  :global(.share-line) { background: #06c755; color: #fff !important; }

  :global(.popup-footer) {
    display: flex; align-items: center;
    justify-content: space-between; gap: 8px;
  }
  :global(.gmaps-link) {
    font-size: 12px; color: #2d8653; font-weight: 600; text-decoration: none;
  }
  :global([data-dark]) :global(.gmaps-link) { color: #4caf8a; }
  :global(.popup-action-btns) { display: flex; gap: 6px; }
  :global(.fav-btn), :global(.itin-btn) {
    background: none; border: none;
    font-size: 20px; cursor: pointer; padding: 0; line-height: 1;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.15s;
  }
  :global(.fav-btn:active), :global(.itin-btn:active) { transform: scale(1.3); }

  /* Nearby bar */
  #nearby-bar {
    position: absolute; top: 12px; left: 50%; transform: translateX(-50%);
    background: #fff; border-radius: 24px; padding: 8px 14px;
    display: flex; align-items: center; gap: 10px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.18);
    z-index: 500; white-space: nowrap;
  }
  :global([data-dark]) #nearby-bar { background: #2a2a2a; box-shadow: 0 2px 12px rgba(0,0,0,0.5); }
  #nearby-bar.hidden { display: none; }
  #nearby-label { font-size: 13px; font-weight: 600; color: #1a1a1a; }
  :global([data-dark]) #nearby-label { color: #f0f0f0; }
  #radius-pills { display: flex; gap: 4px; }
  .radius-pill {
    background: #f0f0f0; border: none; border-radius: 12px;
    padding: 4px 10px; font-size: 12px; font-weight: 600;
    cursor: pointer; color: #555; font-family: inherit;
    -webkit-tap-highlight-color: transparent; transition: background 0.15s;
  }
  :global([data-dark]) .radius-pill { background: #3a3a3a; color: #ccc; }
  .radius-pill.active { background: #2d8653; color: #fff; }
  #nearby-close {
    background: none; border: none; font-size: 14px; color: #aaa;
    cursor: pointer; padding: 0 2px; -webkit-tap-highlight-color: transparent;
  }

  /* Search bar */
  #search-bar {
    position: absolute; top: 12px; right: 12px;
    display: flex; align-items: center; gap: 6px;
    background: #fff; border-radius: 24px; padding: 7px 12px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.18);
    z-index: 500;
    width: 44px; /* collapsed: just icon */
    overflow: hidden;
    transition: width 0.25s ease;
    flex-direction: row-reverse;
  }
  #search-bar.open { width: min(260px, calc(100vw - 80px)); flex-direction: row; }
  :global([data-dark]) #search-bar { background: #2a2a2a; box-shadow: 0 2px 12px rgba(0,0,0,0.5); }
  #search-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; cursor: pointer; color: #555; }
  :global([data-dark]) #search-icon { color: #aaa; }
  #search-input {
    border: none; outline: none; background: transparent;
    font-size: 13px; font-family: inherit; color: #1a1a1a;
    width: 0; flex: 1; min-width: 0;
    transition: width 0.25s;
  }
  #search-bar.open #search-input { width: 100%; }
  :global([data-dark]) #search-input { color: #f0f0f0; }
  #search-input::placeholder { color: #aaa; }
  #search-clear {
    background: none; border: none; font-size: 13px; color: #aaa;
    cursor: pointer; padding: 0 2px; flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
  }
  #search-clear.hidden { display: none; }

  /* ── 圖層面板（對應 Google My Maps 左側的圖層清單）────────── */
  #layers-btn {
    position: absolute; top: 64px; left: 12px; z-index: 500;
    display: flex; align-items: center; gap: 7px;
    height: 44px; padding: 0 14px 0 11px;
    background: #fff; border: none; border-radius: 22px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    font-size: 13px; font-weight: 600; color: #333; font-family: inherit;
    cursor: pointer; -webkit-tap-highlight-color: transparent;
  }
  #layers-btn.hidden { display: none; }
  #layers-btn svg { flex-shrink: 0; }
  :global([data-dark]) #layers-btn { background: #1e1e1e; color: #ccc; box-shadow: 0 2px 8px rgba(0,0,0,0.5); }
  @media (max-width: 767px) {
    #layers-btn { width: 44px; padding: 0; border-radius: 50%; justify-content: center; }
    #layers-btn .layers-label { display: none; }
  }

  #layers-panel {
    position: absolute; top: 0; left: 0; bottom: 0; z-index: 700;
    width: min(300px, 84%);
    background: #fff;
    box-shadow: 2px 0 16px rgba(0,0,0,0.18);
    display: flex; flex-direction: column;
    transition: transform 0.22s ease;
    font-family: inherit;
  }
  #layers-panel.hidden { transform: translateX(-102%); box-shadow: none; }
  :global([data-dark]) #layers-panel { background: #1c1c1c; box-shadow: 2px 0 16px rgba(0,0,0,0.6); }

  .lp-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 12px 10px 14px;
    border-bottom: 1px solid #ececec;
  }
  :global([data-dark]) .lp-head { border-bottom-color: #333; }
  .lp-title { font-size: 14px; font-weight: 700; color: #1a1a1a; }
  :global([data-dark]) .lp-title { color: #f0f0f0; }
  #lp-close {
    background: none; border: none; font-size: 15px; color: #999;
    cursor: pointer; padding: 2px 4px; line-height: 1;
    -webkit-tap-highlight-color: transparent;
  }

  .lp-actions { display: flex; gap: 6px; padding: 10px 14px; }
  .lp-act {
    flex: 1; background: #f4f4f4; border: none; border-radius: 8px;
    padding: 6px 0; font-size: 12px; font-weight: 600; color: #555;
    cursor: pointer; font-family: inherit;
    -webkit-tap-highlight-color: transparent;
  }
  :global([data-dark]) .lp-act { background: #2c2c2c; color: #bbb; }

  #lp-list { flex: 1; overflow-y: auto; padding: 0 6px 16px; -webkit-overflow-scrolling: touch; }

  /* 以下的節點是 KML 解析完才用 JS 建出來的，拿不到 Astro 的 scope 屬性，
     必須走 :global()（跟既有的 .cat-pill 同樣理由） */
  :global(.lp-layer) { border-bottom: 1px solid #f2f2f2; }
  :global([data-dark]) :global(.lp-layer) { border-bottom-color: #2a2a2a; }
  :global(.lp-row) {
    display: flex; align-items: center; gap: 8px;
    padding: 9px 8px; cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  :global(.lp-row input) { width: 16px; height: 16px; accent-color: #2d8653; flex-shrink: 0; cursor: pointer; margin: 0; }
  :global(.lp-dot) {
    width: 24px; height: 24px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; flex-shrink: 0;
  }
  :global(.lp-name) {
    flex: 1; font-size: 13px; font-weight: 600; color: #333;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  :global([data-dark]) :global(.lp-name) { color: #ddd; }
  :global(.lp-row input:not(:checked) ~ .lp-name) { color: #aaa; font-weight: 500; }
  :global(.lp-count) { font-size: 11px; color: #999; flex-shrink: 0; }
  :global(.lp-expand) {
    background: none; border: none; color: #bbb; font-size: 15px;
    cursor: pointer; padding: 4px 6px; flex-shrink: 0; line-height: 1;
    transition: transform 0.18s; -webkit-tap-highlight-color: transparent;
  }
  :global(.lp-expand[aria-expanded="true"]) { transform: rotate(90deg); }

  :global(.lp-places) { list-style: none; margin: 0; padding: 0 0 8px 40px; }
  :global(.lp-places.hidden) { display: none; }
  :global(.lp-places button) {
    display: block; width: 100%; text-align: left;
    background: none; border: none; font-family: inherit;
    font-size: 12.5px; color: #555; line-height: 1.4;
    padding: 6px 8px 6px 0; cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  :global([data-dark]) :global(.lp-places button) { color: #aaa; }
  :global(.lp-places button:hover) { color: #2d8653; }

  /* Category bar */
  #cat-bar {
    position: absolute; bottom: 60px; left: 0; right: 0;
    z-index: 500; pointer-events: none;
  }
  #cat-bar.hidden { display: none; }
  #cat-pills {
    display: flex; gap: 6px; padding: 0 12px;
    overflow-x: auto; -webkit-overflow-scrolling: touch;
    scrollbar-width: none; pointer-events: all;
  }
  #cat-pills::-webkit-scrollbar { display: none; }

  /* Desktop: show scrollbar so users know it's scrollable */
  @media (hover: hover) {
    #cat-bar { bottom: 68px; }
    #cat-pills {
      scrollbar-width: thin;
      scrollbar-color: rgba(0,0,0,0.2) transparent;
      padding-bottom: 6px;
    }
    #cat-pills::-webkit-scrollbar { display: block; height: 4px; }
    #cat-pills::-webkit-scrollbar-track { background: transparent; }
    #cat-pills::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.2); border-radius: 2px; }
    #cat-pills::-webkit-scrollbar-thumb:hover { background: rgba(0,0,0,0.4); }
  }
  :global(.cat-pill) {
    display: flex; align-items: center; gap: 4px;
    background: #fff; border: 1.5px solid #e8e8e8;
    border-radius: 20px; padding: 6px 12px;
    font-size: 12px; font-weight: 600; color: #555;
    white-space: nowrap; cursor: pointer;
    box-shadow: 0 1px 4px rgba(0,0,0,0.12);
    font-family: inherit; -webkit-tap-highlight-color: transparent;
    transition: all 0.15s; flex-shrink: 0;
  }
  :global([data-dark]) :global(.cat-pill) {
    background: #2a2a2a; border-color: #3a3a3a; color: #ccc;
  }
  :global(.cat-pill.active) { background: #1a1a1a; border-color: #1a1a1a; color: #fff; }
  :global([data-dark]) :global(.cat-pill.active) { background: #2d8653; border-color: #2d8653; }

  /* Hide native geolocate button (we use custom #gps-btn) */
  :global(.maplibregl-ctrl-geolocate) { display: none !important; }

  /* MapLibre control dark overrides */
  :global([data-dark]) :global(.maplibregl-ctrl-group) {
    background: #2a2a2a !important;
    box-shadow: 0 0 0 1px #3a3a3a !important;
  }
  :global([data-dark]) :global(.maplibregl-ctrl button) {
    background-color: #2a2a2a !important;
  }
  :global([data-dark]) :global(.maplibregl-ctrl button span) {
    filter: invert(1);
  }
</style>

<script define:vars={{ area }}>
  async function initMap() {
    // Load MapLibre GL UMD
    if (!window.maplibregl) {
      await new Promise((res, rej) => {
        const s = document.createElement('script');
        s.src = '/vendor/maplibre/maplibre-gl.js';
        s.onload = res; s.onerror = rej;
        document.head.appendChild(s);
      });
    }
    const mgl = window.maplibregl;

    const STYLE_LIGHT = 'https://tiles.openfreemap.org/styles/liberty';
    const STYLE_DARK = 'https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json';
    const isDark = () => document.documentElement.hasAttribute('data-dark');

    const map = new mgl.Map({
      container: 'map',
      style: isDark() ? STYLE_DARK : STYLE_LIGHT,
      center: [area.center[1], area.center[0]], // MapLibre: [lng, lat]
      zoom: area.zoom,
      attributionControl: { compact: true },
    });

    map.addControl(new mgl.NavigationControl({ showCompass: false }), 'bottom-right');

    const geolocate = new mgl.GeolocateControl({
      positionOptions: { enableHighAccuracy: true },
      trackUserLocation: true,
      showUserHeading: false,
      showAccuracyCircle: true,
    });
    map.addControl(geolocate, 'bottom-right');

    // ─── State ────────────────────────────────────────────────
    let allFeatures = [];
    let categories = [];
    // 被關掉的圖層。用「隱藏集合」而非「顯示集合」，新解析出來的圖層才會預設可見。
    // 底部 pills（單選「只看這一類」）與左側圖層面板（多選勾選）共用這份狀態。
    const hiddenCats = new Set();
    let searchQuery = '';
    let nearbyActive = false;
    let nearbyRadius = 1;
    let userLat = null, userLng = null;
    let eventsSetup = false;
    let kmlParsed = false;
    let mapStyleReady = false;
    let initialFitDone = false;

    // ─── Expose map API for GPS handler in [area].astro ──────────
    window._mapApi = {
      flyTo: (lat, lng, zoom = 14) => map.flyTo({ center: [lng, lat], zoom }),
      getZoom: () => map.getZoom(),
      setUserLocation(lat, lng) {
        userLat = lat; userLng = lng;
        if (!map.getSource('user-loc')) {
          map.addSource('user-loc', { type: 'geojson', data: { type: 'Feature', geometry: { type: 'Point', coordinates: [lng, lat] } } });
          map.addLayer({ id: 'user-loc-dot', type: 'circle', source: 'user-loc', paint: { 'circle-radius': 8, 'circle-color': '#1a6ef5', 'circle-stroke-width': 2, 'circle-stroke-color': '#fff' } });
        } else {
          map.getSource('user-loc').setData({ type: 'Feature', geometry: { type: 'Point', coordinates: [lng, lat] } });
        }
        if (nearbyActive) refreshData();
      },
      enableNearby() {
        nearbyActive = true;
        document.getElementById('nearby-bar')?.classList.remove('hidden');
        refreshData();
      },
      disableNearby() {
        nearbyActive = false;
        userLat = null; userLng = null;
        document.getElementById('nearby-bar')?.classList.add('hidden');
        const gpsBtn = document.getElementById('gps-btn');
        if (gpsBtn) {
          gpsBtn.classList.remove('active');
          gpsBtn.dataset.state = 'idle';
          const lbl = gpsBtn.querySelector('.gps-label');
          if (lbl) lbl.textContent = '我的位置';
        }
        if (map.getLayer('user-loc-dot')) map.removeLayer('user-loc-dot');
        if (map.getSource('user-loc')) map.removeSource('user-loc');
        refreshData();
      },
    };

    // ─── Search bar ───────────────────────────────────────────
    const searchBar = document.getElementById('search-bar');
    const searchInput = document.getElementById('search-input');
    const searchClear = document.getElementById('search-clear');
    let composing = false;

    searchBar?.addEventListener('click', (e) => {
      if (!searchBar.classList.contains('open')) {
        searchBar.classList.add('open');
        searchInput?.focus();
      }
    });

    searchInput?.addEventListener('compositionstart', () => { composing = true; });
    searchInput?.addEventListener('compositionend', () => {
      composing = false;
      searchQuery = searchInput.value.trim();
      searchClear?.classList.toggle('hidden', !searchQuery);
      refreshData();
    });

    searchInput?.addEventListener('input', () => {
      if (composing) return;
      searchQuery = searchInput.value.trim();
      searchClear?.classList.toggle('hidden', !searchQuery);
      refreshData();
    });

    searchClear?.addEventListener('click', (e) => {
      e.stopPropagation();
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      searchClear.classList.add('hidden');
      refreshData();
      searchInput?.focus();
    });

    // Close search bar when clicking outside
    document.addEventListener('click', (e) => {
      if (!searchBar?.contains(e.target) && searchBar?.classList.contains('open') && !searchQuery) {
        searchBar.classList.remove('open');
      }
    });

    document.getElementById('nearby-close')?.addEventListener('click', () => window._mapApi.disableNearby());

    document.getElementById('radius-pills')?.addEventListener('click', (e) => {
      const pill = e.target.closest('.radius-pill');
      if (!pill) return;
      document.querySelectorAll('.radius-pill').forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      nearbyRadius = parseFloat(pill.dataset.km);
      if (nearbyActive) refreshData();
    });

    // ─── Helpers ──────────────────────────────────────────────
    function haversine(lat1, lng1, lat2, lng2) {
      const R = 6371, dLat = (lat2-lat1)*Math.PI/180, dLng = (lng2-lng1)*Math.PI/180;
      const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLng/2)**2;
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    }

    function getFilteredFeatures() {
      const q = searchQuery.toLowerCase();
      return allFeatures.filter(f => {
        const { category, lat, lng, name } = f.properties;
        const catOk = !hiddenCats.has(category);
        const nearbyOk = !nearbyActive || userLat === null || haversine(userLat, userLng, lat, lng) <= nearbyRadius;
        const searchOk = !q || name.toLowerCase().includes(q);
        return catOk && nearbyOk && searchOk;
      });
    }

    // 線性內插百分位數，用來裁掉離群座標
    function percentile(sorted, p) {
      const idx = (sorted.length - 1) * p;
      const lo = Math.floor(idx), hi = Math.ceil(idx);
      return lo === hi ? sorted[lo] : sorted[lo] + (sorted[hi] - sorted[lo]) * (idx - lo);
    }

    function fitToFeatures(features, { anchorToArea = false } = {}) {
      if (features.length === 0) return;
      // Filter out coordinates outside Bali (data errors)
      const valid = features.filter(f => {
        const [lng, lat] = f.geometry.coordinates;
        return lng > 114.4 && lng < 116.0 && lat > -9.0 && lat < -7.8;
      });
      const toFit = valid.length > 0 ? valid : features;
      if (toFit.length === 1) {
        map.flyTo({ center: toFit[0].geometry.coordinates, zoom: 15 });
        return;
      }

      // 分區地圖常有幾根釘子落在區外（庫塔圖裡的 Denpasar 伴手禮店、烏布圖裡
      // 的遠郊梯田）。直接取 min/max 會被這幾根拉到整座島的視角，主要景點全擠
      // 在中間一小塊。先砍掉離中位數中心最遠的 8%——用平面距離而不是單軸百分
      // 位，斜角方向的離群點才抓得到。
      let kept = toFit;
      if (toFit.length >= 12) {
        const lngs = toFit.map(f => f.geometry.coordinates[0]).sort((a, b) => a - b);
        const lats = toFit.map(f => f.geometry.coordinates[1]).sort((a, b) => a - b);
        const cLng = percentile(lngs, 0.5), cLat = percentile(lats, 0.5);
        const distOf = f => Math.hypot(f.geometry.coordinates[0] - cLng, f.geometry.coordinates[1] - cLat);
        const cut = percentile(toFit.map(distOf).sort((a, b) => a - b), 0.92);
        const trimmed = toFit.filter(f => distOf(f) <= cut);
        if (trimmed.length >= 3) kept = trimmed;
      }

      let minLng = Infinity, maxLng = -Infinity, minLat = Infinity, maxLat = -Infinity;
      kept.forEach(f => {
        const [lng, lat] = f.geometry.coordinates;
        minLng = Math.min(minLng, lng); maxLng = Math.max(maxLng, lng);
        minLat = Math.min(minLat, lat); maxLat = Math.max(maxLat, lat);
      });
      const bounds = [[minLng - 0.005, minLat - 0.005], [maxLng + 0.005, maxLat + 0.005]];

      // 初次載入：有些分區圖的釘子真的橫跨半座島（烏布 197 筆攤開來只有 z8.4），
      // 硬要框住全部只會得到一個「159」的巨大聚合圓圈。這種情況退回 maps.ts 手
      // 調的 area.center／area.zoom——那才是使用者點「烏布攻略地圖」想看到的地方，
      // 區外的點交給聚合圓圈和左側圖層清單。
      if (anchorToArea) {
        const floor = area.zoom - 2;
        let cam;
        try { cam = map.cameraForBounds(bounds, { padding: 60 }); } catch { cam = null; }
        if (!cam || !Number.isFinite(cam.zoom) || cam.zoom < floor) {
          map.easeTo({ center: [area.center[1], area.center[0]], zoom: floor, duration: 600 });
          return;
        }
      }
      map.fitBounds(bounds, { padding: 60, maxZoom: 15, duration: 600 });
    }

    function refreshData() {
      if (map.getSource('places')) {
        map.getSource('places').setData({ type: 'FeatureCollection', features: getFilteredFeatures() });
      }
    }

    function createEmojiIcon(emoji, color, size = 40) {
      const c = document.createElement('canvas');
      c.width = c.height = size;
      const ctx = c.getContext('2d');
      ctx.shadowColor = 'rgba(0,0,0,0.3)';
      ctx.shadowBlur = 4;
      ctx.shadowOffsetY = 1.5;
      ctx.beginPath();
      ctx.arc(size/2, size/2, size/2 - 3, 0, Math.PI*2);
      ctx.fillStyle = color;
      ctx.fill();
      ctx.shadowColor = 'transparent';
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 2.5;
      ctx.stroke();
      ctx.font = `${Math.floor(size*0.43)}px serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(emoji, size/2, size/2 + 0.5);
      const d = ctx.getImageData(0, 0, size, size);
      return { width: size, height: size, data: d.data };
    }

    function sanitizeIconId(name) {
      return name.replace(/[^a-zA-Z0-9一-鿿぀-ヿ]/g, '_');
    }

    function getCatStyle(name) {
      const s = name.toLowerCase();
      if (s.includes('美食') || s.includes('eating') || s.includes('餐廳') || s.includes('food'))
        return { emoji: '🍽️', color: '#e67e22' };
      if (s.includes('咖啡') || s.includes('cafe') || s.includes('coffee'))
        return { emoji: '☕', color: '#795548' };
      if (s.includes('住宿') || s.includes('hotel') || s.includes('villa') || s.includes('resort'))
        return { emoji: '🏨', color: '#3498db' };
      if (s.includes('購物') || s.includes('shopping') || s.includes('血拼'))
        return { emoji: '🛍️', color: '#9b59b6' };
      if (s.includes('spa') || s.includes('水療') || s.includes('按摩'))
        return { emoji: '💆', color: '#1abc9c' };
      if (s.includes('夜店') || s.includes('bar') || s.includes('nightlife') || s.includes('酒吧'))
        return { emoji: '🍸', color: '#e91e63' };
      if (s.includes('瀑布') || s.includes('waterfall'))
        return { emoji: '💧', color: '#00bcd4' };
      if (s.includes('親子') || s.includes('family') || s.includes('kids'))
        return { emoji: '👨‍👩‍👧', color: '#ff9800' };
      if (s.includes('烹飪') || s.includes('cooking'))
        return { emoji: '👨‍🍳', color: '#607d8b' };
      if (s.includes('衝浪') || s.includes('surf'))
        return { emoji: '🏄', color: '#00bcd4' };
      if (s.includes('潛水') || s.includes('dive') || s.includes('snorkel'))
        return { emoji: '🤿', color: '#0288d1' };
      if (s.includes('活動') || s.includes('activities') || s.includes('必訪'))
        return { emoji: '🎯', color: '#e74c3c' };
      if (s.includes('景點') || s.includes('sight') || s.includes('temple'))
        return { emoji: '🏛️', color: '#2d8653' };
      if (s.includes('秋千') || s.includes('swing'))
        return { emoji: '🎪', color: '#ff5722' };
      if (s.includes('步道') || s.includes('trail') || s.includes('trek'))
        return { emoji: '🥾', color: '#8bc34a' };
      return { emoji: '📍', color: '#546e7a' };
    }

    function getOsmTile(lat, lng) {
      const zoom = 15, n = Math.pow(2, zoom);
      const xF = (lng+180)/360*n;
      const latRad = lat*Math.PI/180;
      const yF = (1 - Math.log(Math.tan(latRad)+1/Math.cos(latRad))/Math.PI)/2*n;
      const xT = Math.floor(xF), yT = Math.floor(yF);
      return {
        url: `https://tile.openstreetmap.org/${zoom}/${xT}/${yT}.png`,
        bgX: Math.round(-((xF-xT)*256-120)),
        bgY: Math.round(-((yF-yT)*256-65)),
      };
    }

    // Google My Maps 上傳的照片擋第三方 hotlink（瀏覽器會帶 Origin /
    // Sec-Fetch-Site，Google 直接拒絕），直接引用一定載入失敗，必須走
    // /api/map-image 代取。順便把 KML 給的 16383px 原圖換成縮圖尺寸。
    const MYMAPS_IMG_RE =
      /^https:\/\/mymaps\.usercontent\.google\.com\/hostedimage\/m\/\*\/([A-Za-z0-9_-]+)/;

    function proxyImg(url) {
      if (!url) return '';
      const m = url.match(MYMAPS_IMG_RE);
      return m ? `/api/map-image?id=${m[1]}&v=thumb` : url;
    }

    function extractImg(raw) {
      const m = raw.match(/<img[^>]+src=["'](https?:\/\/[^"']+)["']/i);
      return m ? proxyImg(m[1]) : null;
    }

    // 照片在 KML 裡有兩個來源：description 的 <img>，以及 ExtendedData 的
    // gx_media_links。目前實測 314 個有圖的地點兩者都有，但後者才是 Google
    // 的正規欄位，留著當 description 被改寫時的後備。
    function extractMediaLink(pm) {
      // KML 有預設 namespace，沿用檔案其他地方的做法：先試 tagName，再試 NS 萬用
      const datas = pm.getElementsByTagName('Data').length
        ? pm.getElementsByTagName('Data')
        : pm.getElementsByTagNameNS('*', 'Data');
      for (const d of Array.from(datas)) {
        if (d.getAttribute('name') !== 'gx_media_links') continue;
        const v = d.getElementsByTagName('value')[0]
          || d.getElementsByTagNameNS('*', 'value')[0];
        // 多張照片是空白分隔，取第一張當縮圖
        return (v?.textContent || '').trim().split(/\s+/)[0] || '';
      }
      return '';
    }

    function formatDesc(raw) {
      if (!raw) return '';
      // Drop table rows where every <td> (value cell) is empty —
      // Google My Maps KML artefact: 名称：, 说明：, etc. with no value
      let html = raw.replace(/<tr\b[^>]*>[\s\S]*?<\/tr>/gi, row => {
        const tdContents = (row.match(/<td[^>]*>([\s\S]*?)<\/td>/gi) || [])
          .map(td => td.replace(/<[^>]*>/g, '').replace(/&nbsp;/g, '').trim());
        if (tdContents.length > 0 && tdContents.every(c => c === '')) return '';
        return row;
      });
      const withLinks = html
        .replace(/<a\s+href="([^"]+)"[^>]*>(.*?)<\/a>/gi, '§§§$1§§§$2§§§')
        .replace(/<[^>]*>/g, '')
        .replace(/§§§([^§]+)§§§([^§]*)§§§/g, (_, href, text) =>
          `<a href="${href}" target="_blank" rel="noopener">${text.trim() || href}</a>`);
      return withLinks.replace(
        /(?<![">])(https?:\/\/[^\s<）)]+)/g,
        url => `<a href="${url}" target="_blank" rel="noopener">${url}</a>`
      );
    }

    // 借用當前底圖 style 自己在用的字型堆疊，確保 glyph 一定抓得到
    function pickFontStack() {
      try {
        for (const l of (map.getStyle().layers || [])) {
          const f = l.layout && l.layout['text-font'];
          if (Array.isArray(f) && typeof f[0] === 'string') return f;
        }
      } catch {}
      return ['Noto Sans Regular'];
    }

    // ─── Layer setup (called after initial load + after style change) ────
    function setupLayers() {
      if (!kmlParsed) return;
      // Register emoji icons
      categories.forEach(cat => {
        const id = `icon-${sanitizeIconId(cat.name)}`;
        if (!map.hasImage(id)) map.addImage(id, createEmojiIcon(cat.style.emoji, cat.style.color));
      });

      const data = { type: 'FeatureCollection', features: getFilteredFeatures() };
      if (!map.getSource('places')) {
        map.addSource('places', {
          type: 'geojson',
          data,
          // 密集區（庫塔海灘一帶、烏布市區）不聚合的話幾十根釘子會疊成看不懂的
          // 一團。半徑抓比 icon（40px）稍大，避免相鄰的聚合圓圈自己又疊在一起；
          // 沒撞到的點照樣維持 emoji 釘子。
          cluster: true,
          clusterMaxZoom: 15,
          clusterRadius: 55,
        });
      } else {
        map.getSource('places').setData(data);
      }

      if (!map.getLayer('clusters')) {
        try {
          map.addLayer({
            id: 'clusters', type: 'circle', source: 'places',
            filter: ['has', 'point_count'],
            paint: {
              'circle-color': '#2d8653',
              'circle-opacity': 0.92,
              'circle-radius': ['step', ['get', 'point_count'], 17, 10, 21, 30, 25, 100, 30],
              'circle-stroke-width': 3,
              'circle-stroke-color': '#fff',
            },
          });
          map.addLayer({
            id: 'cluster-count', type: 'symbol', source: 'places',
            filter: ['has', 'point_count'],
            layout: {
              'text-field': ['get', 'point_count_abbreviated'],
              // 淺色/深色底圖的可用字型不同，直接沿用當前 style 已載入的字型堆疊，
              // 否則 glyph 抓不到數字就不會顯示
              'text-font': pickFontStack(),
              'text-size': 13,
              'text-allow-overlap': true,
              'text-ignore-placement': true,
            },
            paint: { 'text-color': '#fff' },
          });
        } catch (e) { console.error('[map] addLayer clusters failed:', e); }
      }

      if (!map.getLayer('points')) {
        try {
          map.addLayer({
            id: 'points', type: 'symbol', source: 'places',
            filter: ['!', ['has', 'point_count']],
            layout: {
              'icon-image': ['get', 'iconImage'],
              'icon-size': 1,
              // 放到最大才全部畫出來；在那之前讓 MapLibre 自己避讓，保持可讀
              'icon-allow-overlap': ['step', ['zoom'], false, 16, true],
              'icon-ignore-placement': ['step', ['zoom'], false, 16, true],
            },
          });
        } catch (e) { console.error('[map] addLayer points failed:', e); }
      }

      // Register events once
      if (!eventsSetup) {
        eventsSetup = true;

        map.on('click', 'points', (e) => {
          const props = e.features[0].properties;
          const coords = e.features[0].geometry.coordinates.slice();
          while (Math.abs(e.lngLat.lng - coords[0]) > 180) {
            coords[0] += e.lngLat.lng > coords[0] ? 360 : -360;
          }
          new mgl.Popup({ maxWidth: '280px', offset: 20 })
            .setLngLat(coords)
            .setDOMContent(buildPopupDOM(props))
            .addTo(map);
        });

        map.on('mouseenter', 'points', () => { map.getCanvas().style.cursor = 'pointer'; });
        map.on('mouseleave', 'points', () => { map.getCanvas().style.cursor = ''; });

        // 點聚合圓圈 → 放大到剛好能拆開這一團的 zoom
        map.on('click', 'clusters', (e) => {
          const f = map.queryRenderedFeatures(e.point, { layers: ['clusters'] })[0];
          if (!f) return;
          const src = map.getSource('places');
          Promise.resolve(src.getClusterExpansionZoom(f.properties.cluster_id))
            .then(z => {
              if (!Number.isFinite(z)) return;
              map.easeTo({ center: f.geometry.coordinates, zoom: Math.min(z, 18), duration: 500 });
            })
            .catch(() => {});
        });

        map.on('mouseenter', 'clusters', () => { map.getCanvas().style.cursor = 'pointer'; });
        map.on('mouseleave', 'clusters', () => { map.getCanvas().style.cursor = ''; });
      }
    }

    // ─── Popup DOM builder ────────────────────────────────────
    function isFaved(id) {
      try { return !!JSON.parse(localStorage.getItem('map_favs')||'{}')[id]; } catch { return false; }
    }
    function isInItinerary(id) {
      try { return (JSON.parse(localStorage.getItem('map_itinerary')||'[]')).some(x => x.id === id); } catch { return false; }
    }

    function buildPopupDOM(props) {
      const lat = parseFloat(props.lat), lng = parseFloat(props.lng);
      const tile = getOsmTile(lat, lng);
      const shareText = encodeURIComponent(`${props.name}\nhttps://www.google.com/maps/search/?api=1&query=${lat},${lng}`);
      const waUrl = `https://wa.me/?text=${shareText}`;
      const lineUrl = `https://line.me/R/msg/text/?${shareText}`;

      const wrap = document.createElement('div');

      // Thumbnail
      const thumb = document.createElement('div');
      thumb.className = 'popup-thumb';
      if (props.imgUrl) {
        const img = document.createElement('img');
        img.src = props.imgUrl;
        img.alt = props.name;
        img.width = 280; img.height = 140;
        img.loading = 'lazy';
        img.onerror = () => {
          img.remove();
          thumb.style.backgroundImage = `url('${tile.url}')`;
          thumb.style.backgroundPosition = `${tile.bgX}px ${tile.bgY}px`;
          const dot = document.createElement('div');
          dot.className = 'popup-thumb-dot';
          thumb.appendChild(dot);
        };
        thumb.appendChild(img);
      } else {
        thumb.style.backgroundImage = `url('${tile.url}')`;
        thumb.style.backgroundPosition = `${tile.bgX}px ${tile.bgY}px`;
        const dot = document.createElement('div');
        dot.className = 'popup-thumb-dot';
        thumb.appendChild(dot);
      }
      wrap.appendChild(thumb);

      // Body
      const body = document.createElement('div');
      body.className = 'map-popup';

      const badge = document.createElement('span');
      badge.className = 'cat-badge';
      badge.style.background = props.catColor;
      badge.textContent = `${props.catEmoji} ${props.category}`;
      body.appendChild(badge);

      const title = document.createElement('h3');
      title.textContent = props.name;
      body.appendChild(title);

      const descHtml = formatDesc(props.rawDesc || '');
      if (descHtml) {
        const p = document.createElement('p');
        p.innerHTML = descHtml;
        body.appendChild(p);
      }

      // Navigate button
      const navBtn = document.createElement('a');
      navBtn.className = 'nav-btn';
      navBtn.href = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}&travelmode=driving`;
      navBtn.target = '_blank';
      navBtn.rel = 'noopener';
      navBtn.textContent = '🧭 使用 Google Maps 導航';
      body.appendChild(navBtn);

      // Share row
      const shareRow = document.createElement('div');
      shareRow.className = 'share-row';
      shareRow.innerHTML = `
        <a class="share-btn share-wa" href="${waUrl}" target="_blank" rel="noopener">📱 WhatsApp</a>
        <a class="share-btn share-line" href="${lineUrl}" target="_blank" rel="noopener">💬 LINE</a>`;
      body.appendChild(shareRow);

      // Footer: gmaps link + action buttons
      const footer = document.createElement('div');
      footer.className = 'popup-footer';

      const gmapsLink = document.createElement('a');
      gmapsLink.className = 'gmaps-link';
      gmapsLink.href = `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`;
      gmapsLink.target = '_blank';
      gmapsLink.rel = 'noopener';
      gmapsLink.textContent = '查看詳情 →';
      footer.appendChild(gmapsLink);

      const actionBtns = document.createElement('div');
      actionBtns.className = 'popup-action-btns';

      const favBtn = document.createElement('button');
      favBtn.className = 'fav-btn';
      favBtn.title = '收藏';
      favBtn.textContent = isFaved(props.id) ? '❤️' : '🤍';
      favBtn.addEventListener('click', () => {
        try {
          const favs = JSON.parse(localStorage.getItem('map_favs')||'{}');
          if (favs[props.id]) {
            delete favs[props.id];
            favBtn.textContent = '🤍';
          } else {
            favs[props.id] = { name: props.name, area: props.areaName, lat, lng, desc: (props.rawDesc||'').replace(/<[^>]*>/g,'').substring(0,300), areaSlug: props.areaSlug };
            favBtn.textContent = '❤️';
          }
          localStorage.setItem('map_favs', JSON.stringify(favs));
        } catch {}
      });
      actionBtns.appendChild(favBtn);

      const itinBtn = document.createElement('button');
      itinBtn.className = 'itin-btn';
      itinBtn.title = '加入行程';
      itinBtn.textContent = isInItinerary(props.id) ? '✅' : '📋';
      itinBtn.addEventListener('click', () => {
        try {
          let itin = JSON.parse(localStorage.getItem('map_itinerary')||'[]');
          const idx = itin.findIndex(x => x.id === props.id);
          if (idx >= 0) {
            itin.splice(idx, 1);
            itinBtn.textContent = '📋';
          } else {
            itin.push({
              id: props.id, name: props.name,
              areaName: props.areaName, areaSlug: props.areaSlug,
              lat, lng,
              desc: (props.rawDesc||'').replace(/<[^>]*>/g,'').substring(0,80),
              category: props.category,
            });
            itinBtn.textContent = '✅';
          }
          localStorage.setItem('map_itinerary', JSON.stringify(itin));
          localStorage.removeItem('map_itinerary_groups'); // force re-group on itinerary page
          window.updateItinBadge?.();
        } catch {}
      });
      actionBtns.appendChild(itinBtn);

      footer.appendChild(actionBtns);
      body.appendChild(footer);
      wrap.appendChild(body);
      return wrap;
    }

    // ─── KML + map init (parallel, decoupled) ────────────────
    // trySetupLayers runs when BOTH style and KML are ready.
    // style.load fires as soon as the style JSON is parsed — no need
    // to wait for tiles — so addSource/addLayer work immediately.
    function trySetupLayers() {
      if (!mapStyleReady || !kmlParsed) return;
      setupLayers();
      if (!initialFitDone && allFeatures.length > 0) {
        fitToFeatures(allFeatures, { anchorToArea: true });
        initialFitDone = true;
      }
    }

    map.on('style.load', () => {
      mapStyleReady = true;
      trySetupLayers();
    });

    // Safety net: if style.load never fires (rare network failure), try after 10s
    setTimeout(() => { if (!mapStyleReady) { mapStyleReady = true; trySetupLayers(); } }, 10000);

    // Fetch KML immediately — don't wait for map tiles
    try {
      const kmlUrl = area.myMapsId ? `/api/kml?mid=${area.myMapsId}` : area.kml;
      let res = await fetch(kmlUrl);
      if (!res.ok) {
        console.error('[map] KML proxy failed:', res.status, kmlUrl, '— falling back to local KML');
        res = await fetch(area.kml);
      }
      if (!res.ok) {
        console.error('[map] Local KML also failed:', res.status, area.kml);
      }
      const kmlText = await res.text();
      const kmlDoc = new DOMParser().parseFromString(kmlText, 'text/xml');
      const parseError = kmlDoc.querySelector('parsererror');
      if (parseError) {
        console.error('[map] KML XML parse error:', parseError.textContent?.slice(0, 200));
      }
      // Use localName comparison — more reliable than CSS selectors on XML namespaced docs
      function kids(el, tag) {
        return Array.from(el.childNodes).filter(n => n.nodeType === 1 && n.localName === tag);
      }
      function descendant(el, tag) {
        return el.getElementsByTagName
          ? (el.getElementsByTagName(tag)[0] || el.getElementsByTagNameNS('*', tag)[0] || null)
          : null;
      }
      function childText(el, tag) {
        return kids(el, tag)[0]?.textContent?.trim() || '';
      }

      const docEl = kids(kmlDoc.documentElement, 'Document')[0] || kmlDoc.documentElement;
      const folders = Array.from(kmlDoc.getElementsByTagName('Folder'));

      function parsePlacemarks(pms, catName) {
        const style = getCatStyle(catName);
        if (!categories.find(c => c.name === catName)) categories.push({ name: catName, style });
        pms.forEach(pm => {
          const name = childText(pm, 'name');
          const rawDesc = childText(pm, 'description');
          const coordsEl = descendant(pm, 'coordinates');
          if (!coordsEl) return;
          const parts = coordsEl.textContent?.trim().split(',');
          if (!parts || parts.length < 2) return;
          const lng = parseFloat(parts[0]), lat = parseFloat(parts[1]);
          if (isNaN(lat) || isNaN(lng)) return;
          allFeatures.push({
            type: 'Feature',
            geometry: { type: 'Point', coordinates: [lng, lat] },
            properties: {
              id: `${area.slug}::${lat},${lng}`,
              name, rawDesc,
              category: catName, catColor: style.color, catEmoji: style.emoji,
              iconImage: `icon-${sanitizeIconId(catName)}`,
              lat, lng,
              areaSlug: area.slug, areaName: area.name,
              imgUrl: extractImg(rawDesc) || proxyImg(extractMediaLink(pm)),
            },
          });
        });
      }

      folders.forEach(folder => {
        const catName = childText(folder, 'name') || '其他';
        const pms = kids(folder, 'Placemark');
        if (pms.length > 0) parsePlacemarks(pms, catName);
      });

      const topPms = kids(docEl, 'Placemark');
      if (topPms.length > 0) parsePlacemarks(topPms, '景點');

      kmlParsed = true;
      trySetupLayers(); // runs immediately if style is already ready

      // ─── 圖層 UI：底部 pills（快速單選）＋ 左側面板（對應 My Maps 的圖層清單）──
      const catPillsEl = document.getElementById('cat-pills');
      const catBar = document.getElementById('cat-bar');
      const layersBtn = document.getElementById('layers-btn');
      const layersPanel = document.getElementById('layers-panel');
      const lpList = document.getElementById('lp-list');

      // GPS 鈕是 position:fixed 掛在 map-wrapper 外面（z-index 900），比面板高，
      // 面板打開時會壓在標題上，所以開合時一起收掉
      function setPanelOpen(open) {
        layersPanel?.classList.toggle('hidden', !open);
        layersBtn?.setAttribute('aria-expanded', String(open));
        const gps = document.getElementById('gps-btn');
        if (gps) gps.style.visibility = open ? 'hidden' : '';
      }
      function closePanel() { setPanelOpen(false); }

      // 兩套 UI 共用 hiddenCats，任何一邊改動都由這裡統一重畫
      function syncCatUI({ refit = false } = {}) {
        refreshData();
        const visible = categories.filter(c => !hiddenCats.has(c.name));
        // pills：全開 →「全部」亮；剛好剩一個 → 那顆亮；複選狀態 → 都不亮
        catPillsEl?.querySelectorAll('.cat-pill').forEach(p => {
          const cat = p.dataset.cat;
          p.classList.toggle('active',
            cat ? (visible.length === 1 && visible[0].name === cat) : hiddenCats.size === 0);
        });
        lpList?.querySelectorAll('input[data-cat]').forEach(cb => {
          cb.checked = !hiddenCats.has(cb.dataset.cat);
        });
        if (refit) {
          const filtered = getFilteredFeatures();
          if (filtered.length > 0) fitToFeatures(filtered);
        }
      }

      if (catPillsEl && categories.length > 1) {
        catBar?.classList.remove('hidden');
        const allPill = document.createElement('button');
        allPill.className = 'cat-pill active';
        allPill.textContent = '全部';
        catPillsEl.appendChild(allPill);
        categories.forEach(cat => {
          const pill = document.createElement('button');
          pill.className = 'cat-pill';
          pill.innerHTML = `${cat.style.emoji} ${cat.name}`;
          pill.dataset.cat = cat.name;
          catPillsEl.appendChild(pill);
        });
        catPillsEl.addEventListener('click', (e) => {
          const pill = e.target.closest('.cat-pill');
          if (!pill) return;
          const only = pill.dataset.cat;
          hiddenCats.clear();
          if (only) categories.forEach(c => { if (c.name !== only) hiddenCats.add(c.name); });
          syncCatUI({ refit: !!only });
        });
      }

      if (lpList && layersBtn && layersPanel && categories.length > 0) {
        layersBtn.classList.remove('hidden');

        categories.forEach(cat => {
          const places = allFeatures.filter(f => f.properties.category === cat.name);

          const wrap = document.createElement('div');
          wrap.className = 'lp-layer';

          const row = document.createElement('div');
          row.className = 'lp-row';

          const cb = document.createElement('input');
          cb.type = 'checkbox';
          cb.checked = true;
          cb.dataset.cat = cat.name;
          cb.setAttribute('aria-label', `顯示${cat.name}`);

          const dot = document.createElement('span');
          dot.className = 'lp-dot';
          dot.style.background = cat.style.color;
          dot.textContent = cat.style.emoji;

          const nm = document.createElement('span');
          nm.className = 'lp-name';
          nm.textContent = cat.name;

          const cnt = document.createElement('span');
          cnt.className = 'lp-count';
          cnt.textContent = String(places.length);

          const exp = document.createElement('button');
          exp.type = 'button';
          exp.className = 'lp-expand';
          exp.textContent = '›';
          exp.setAttribute('aria-expanded', 'false');
          exp.setAttribute('aria-label', `展開${cat.name}的地點清單`);

          row.append(cb, dot, nm, cnt, exp);

          const ul = document.createElement('ul');
          ul.className = 'lp-places hidden';
          places.forEach(f => {
            const li = document.createElement('li');
            const b = document.createElement('button');
            b.type = 'button';
            b.textContent = f.properties.name;
            b.addEventListener('click', () => {
              const [lng, lat] = f.geometry.coordinates;
              map.flyTo({ center: [lng, lat], zoom: Math.max(map.getZoom(), 16) });
              new mgl.Popup({ maxWidth: '280px', offset: 20 })
                .setLngLat([lng, lat])
                .setDOMContent(buildPopupDOM(f.properties))
                .addTo(map);
              // 手機的面板是覆蓋在地圖上的，跳過去後要讓開
              if (window.matchMedia('(max-width: 767px)').matches) closePanel();
            });
            li.appendChild(b);
            ul.appendChild(li);
          });

          cb.addEventListener('change', () => {
            if (cb.checked) hiddenCats.delete(cat.name); else hiddenCats.add(cat.name);
            syncCatUI();
          });
          // 點整列（名稱／圖示／數量）等同開關這個圖層
          [dot, nm, cnt].forEach(el => el.addEventListener('click', () => {
            cb.checked = !cb.checked;
            cb.dispatchEvent(new Event('change'));
          }));
          exp.addEventListener('click', () => {
            const opened = !ul.classList.toggle('hidden');
            exp.setAttribute('aria-expanded', String(opened));
          });

          wrap.append(row, ul);
          lpList.appendChild(wrap);
        });

        layersBtn.addEventListener('click', () => {
          setPanelOpen(layersPanel.classList.contains('hidden'));
        });
        document.getElementById('lp-close')?.addEventListener('click', closePanel);
        layersPanel.querySelectorAll('.lp-act').forEach(btn => {
          btn.addEventListener('click', () => {
            hiddenCats.clear();
            if (btn.dataset.all === 'hide') categories.forEach(c => hiddenCats.add(c.name));
            syncCatUI();
          });
        });
      }
    } catch (err) {
      console.error('KML error:', err);
    }

    document.getElementById('map-loading')?.classList.add('hidden');

    // ─── Dark mode tile switching ─────────────────────────────
    new MutationObserver(() => {
      mapStyleReady = false;
      // diff:false — a diff-based setStyle tries to reconcile our runtime-added
      // 'places' source / 'points' layer against a completely different base
      // style and gets stuck (style.load never fires again, map goes blank).
      // A full reset reliably fires style.load so trySetupLayers() can rebuild.
      map.setStyle(isDark() ? STYLE_DARK : STYLE_LIGHT, { diff: false });
      // style.load will fire and call trySetupLayers() → setupLayers()
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-dark'] });
  }

  initMap();
</script>
