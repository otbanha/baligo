---
/**
 * AboutPageBody.astro — 各語言「關於編輯部」頁共用的版面與 schema。
 * 文案在 src/data/about-i18n.ts，五個語言共用同一個 Organization @id（實體整合）。
 */
import BaseHead from './BaseHead.astro';
import Header from './Header.astro';
import TopStrip from './TopStrip.astro';
import Footer from './Footer.astro';
import { AUTHOR } from '../data/author';
import { ABOUT_COPY, ABOUT_HREFLANGS, aboutUrl, type AboutLang } from '../data/about-i18n';

interface Props { lang: AboutLang }
const { lang } = Astro.props;
const c = ABOUT_COPY[lang];
const selfUrl = aboutUrl(lang);

const profileSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  url: selfUrl,
  inLanguage: c.htmlLang,
  mainEntity: {
    '@type': 'Organization',
    '@id': AUTHOR.id,
    name: c.orgName,
    url: AUTHOR.url,
    description: c.orgDescription,
    sameAs: AUTHOR.sameAs,
    parentOrganization: {
      '@type': 'Organization',
      name: 'Go Bali Go',
      url: 'https://gobaligo.id',
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: c.breadcrumbHome, item: 'https://gobaligo.id' },
    { '@type': 'ListItem', position: 2, name: c.breadcrumbSelf, item: selfUrl },
  ],
};
---

<html lang={c.htmlLang}>
<head>
  <BaseHead title={c.title} description={c.description} type="website" hreflangs={ABOUT_HREFLANGS} noSuffix={true} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(profileSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
</head>

<body>
  <Header lang={lang} basePath="about" />
  <TopStrip lang={lang} />

  <main class="about-wrap">
    <article class="about-card">
      <header class="about-hero">
        <span class="about-avatar" aria-hidden="true">GBG</span>
        <div>
          <h1>{c.h1}</h1>
          <p class="about-role">{c.role}</p>
        </div>
      </header>

      <p set:html={c.intro} />

      <h2>{c.whatH2}</h2>
      <p set:html={c.what} />

      <h2>{c.trustH2}</h2>
      <ul class="about-points">
        {c.trust.map(item => <li set:html={item} />)}
      </ul>

      <h2>{c.startH2}</h2>
      <ul class="about-links">
        {c.links.map(l => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>

      <h2>{c.socialH2}</h2>
      <div class="about-social">
        <a href="https://www.youtube.com/@j_indonesia" target="_blank" rel="noopener" class="about-social-btn yt">{c.youtube}</a>
        <a href="https://www.facebook.com/bali.guide.blog" target="_blank" rel="noopener" class="about-social-btn fb">{c.facebook}</a>
      </div>
    </article>
  </main>

  <Footer />

  <style>
    .about-wrap { max-width: 760px; margin: 0 auto; padding: 32px 16px 80px; box-sizing: border-box; }
    .about-card { background: var(--surface, #fff); border-radius: 16px; padding: clamp(20px, 4vw, 40px); box-shadow: var(--box-shadow, 0 4px 20px rgba(0,0,0,0.06)); }
    .about-hero { display: flex; align-items: center; gap: 18px; margin-bottom: 1.2em; }
    .about-avatar { flex: none; width: 68px; height: 68px; border-radius: 50%; background: linear-gradient(135deg, var(--ocean, #0f3860), #2a7bb8); color: #fff; font-weight: 800; font-size: 1.05em; letter-spacing: 0.02em; display: flex; align-items: center; justify-content: center; }
    .about-hero h1 { margin: 0; font-size: clamp(1.5em, 4vw, 2em); color: var(--ocean, #0f3860); line-height: 1.2; }
    .about-role { margin: 0.3em 0 0; font-size: 0.9em; color: var(--text-light, #64748b); }
    .about-card h2 { font-size: 1.15em; color: var(--ocean, #0f3860); margin: 1.6em 0 0.5em; }
    .about-card p { line-height: 1.85; color: var(--text, #1f2937); }
    .about-points, .about-links { list-style: none; padding: 0; margin: 0.4em 0; }
    .about-points li { line-height: 1.8; margin-bottom: 0.7em; }
    .about-links li { margin-bottom: 0.55em; }
    .about-links a { color: var(--ocean, #0f3860); text-decoration: none; font-weight: 600; }
    .about-links a:hover { text-decoration: underline; }
    .about-social { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 0.6em; }
    .about-social-btn { display: inline-flex; align-items: center; gap: 8px; padding: 0.55em 1em; border-radius: 999px; font-weight: 600; font-size: 0.9em; text-decoration: none; color: #fff; }
    .about-social-btn.yt { background: #ff0000; }
    .about-social-btn.fb { background: #1877f2; }
    .about-social-btn:hover { opacity: 0.9; }
  </style>
</body>
</html>
