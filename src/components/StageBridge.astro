---
/**
 * StageBridge — 文章底部的「下一步該看什麼」導流卡片。
 *
 * 目標文章從 stage-mapping.json（scripts/generate-stage-mapping.mjs 產出）挑選：
 *   decide      → guessedStage 為 choose-area 的文章
 *   choose-area → category 含「住宿推薦」的文章
 *   prepare     → category 含「美食景點活動」的文章
 *   onsite      → category 含「美食景點活動」的文章
 *
 * 排序：region 相同優先 → 其次 visits 由高到低，排除 currentSlug 自己，取前 3 篇。
 * 縮圖／描述另外從 src/content/blog（Astro content collection）補齊，
 * 因為 stage-mapping.json 本身不含這兩個欄位。
 */
import { getCollection } from 'astro:content';
import { readFileSync } from 'fs';
import { join } from 'path';

export type Stage = 'decide' | 'choose-area' | 'prepare' | 'onsite';

interface Props {
  stage: Stage;
  region?: string | null;
  currentSlug: string;
}

const { stage, region = null, currentSlug } = Astro.props;

const TARGET_COUNT = 3;

const STAGE_HEADING: Record<Stage, string> = {
  'decide': '🗺️ 想好要去哪些地方了嗎？',
  'choose-area': '🏨 這幾個住宿你可能也想比較看看',
  'prepare': '🎫 出發前，先把這些安排好',
  'onsite': '🍽️ 人都到了，順便看看這些',
};

// 各 stage 的目標文章篩選規則（讀 stage-mapping.json）
const STAGE_TARGET_CATEGORY: Partial<Record<Stage, string>> = {
  'choose-area': '住宿推薦',
  'prepare': '美食景點活動',
  'onsite': '美食景點活動',
};

interface MappingArticle {
  slug: string;
  title: string;
  category: string[];
  guessedStage: Stage | null;
  guessedRegion: string | null;
  visits: number;
}

function loadStageMapping(): MappingArticle[] {
  try {
    // process.cwd()（專案根目錄）而非 import.meta.url：production build 時
    // component 會被 Vite/Rollup 打包搬移，import.meta.url 已不可靠。
    const mappingPath = join(process.cwd(), 'stage-mapping.json');
    const raw = JSON.parse(readFileSync(mappingPath, 'utf-8'));
    return Array.isArray(raw.articles) ? raw.articles : [];
  } catch {
    return [];
  }
}

function selectPool(stage: Stage, articles: MappingArticle[]): MappingArticle[] {
  if (stage === 'decide') {
    return articles.filter(a => a.guessedStage === 'choose-area');
  }
  const category = STAGE_TARGET_CATEGORY[stage];
  return articles.filter(a => Array.isArray(a.category) && a.category.includes(category!));
}

const stageMapping = loadStageMapping();

const pool = selectPool(stage, stageMapping).filter(a => a.slug !== currentSlug);

const ranked = pool.slice().sort((a, b) => {
  const aRegionMatch = region && a.guessedRegion === region ? 1 : 0;
  const bRegionMatch = region && b.guessedRegion === region ? 1 : 0;
  if (aRegionMatch !== bRegionMatch) return bRegionMatch - aRegionMatch;
  return (b.visits || 0) - (a.visits || 0);
});

const picks = ranked.slice(0, TARGET_COUNT);

// 縮圖／描述：從 blog collection 補齊（stage-mapping.json 不含這兩個欄位）
const blogPosts = picks.length > 0 ? await getCollection('blog') : [];
const postBySlug = new Map(blogPosts.map(p => [p.data.slug || p.id, p]));

function extractFirstImage(body: string | undefined): string {
  const m = body?.match(/!\[.*?\]\((https?:\/\/[^)\s]+)\)/);
  return m ? m[1] : '';
}
function summarize(description: unknown): string {
  const oneLine = String(description ?? '').replace(/\s+/g, ' ').trim();
  const MAX = 60;
  return oneLine.length > MAX ? `${oneLine.slice(0, MAX)}…` : oneLine;
}

const cards = picks.map(item => {
  const post = postBySlug.get(item.slug);
  return {
    slug: item.slug,
    href: `/blog/${item.slug}/`,
    title: item.title,
    summary: post ? summarize(post.data.description) : '',
    image: post ? (post.data.heroImage || extractFirstImage(post.body)) : '',
  };
});

const heading = STAGE_HEADING[stage];
---

{cards.length > 0 && (
  <section class="stage-bridge">
    <h3 class="stage-bridge__heading">{heading}</h3>
    <div class="stage-bridge__list">
      {cards.map(card => (
        <a
          class="stage-bridge__card"
          href={card.href}
          data-bridge-stage={stage}
          data-bridge-target={card.slug}
        >
          <div class="stage-bridge__thumb">
            {card.image
              ? <img src={card.image} alt="" loading="lazy" />
              : <span class="stage-bridge__thumb-ph">🏝️</span>}
          </div>
          <div class="stage-bridge__body">
            <p class="stage-bridge__title">{card.title}</p>
            {card.summary && <p class="stage-bridge__summary">{card.summary}</p>}
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .stage-bridge {
    background: #FEF5ED;
    border: 1px solid rgba(197, 160, 89, 0.35);
    border-radius: 12px;
    padding: 1rem 1.1rem 1.2rem;
    margin: 1.5rem 0;
  }
  .stage-bridge__heading {
    font-size: 0.95rem;
    font-weight: 700;
    color: #5D4037;
    margin: 0 0 0.75rem;
  }
  .stage-bridge__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .stage-bridge__card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border: 1px solid #eee;
    border-radius: 10px;
    overflow: hidden;
  }
  .stage-bridge__thumb {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .stage-bridge__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .stage-bridge__thumb-ph {
    font-size: 1.8rem;
  }
  .stage-bridge__body {
    padding: 0.6rem 0.7rem;
  }
  .stage-bridge__title {
    margin: 0 0 0.3rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .stage-bridge__summary {
    margin: 0;
    font-size: 0.78rem;
    color: #666;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-width: 640px) {
    .stage-bridge__list {
      grid-template-columns: 1fr;
    }
  }
</style>
